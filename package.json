{
    "name": "simGraphVisualizer",
    "version": "1.0.0",
    "description": "test",
    "author": "Dariusz Pojda <dpojda@iitis.pl>",
    "license": "Apache-2.0",
    "main": "scripts/main.js",
    "scripts": {
        "clean": "gulp clean",
        "build": "gulp build",
        "minimize": "gulp minimize",
        "merge": "gulp merge",
        "start": "electron-forge start",
        "watch": "nodemon --exec electron .",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "make-docs": "jsdoc src/ -R README.md -d docs"
    },
    "dependencies": {
        "axios": "^1.7.4",
        "babylonjs": "5.57.1",
        "babylonjs-gui": "5.57.1",
        "bulma": "0.9.4",
        "jquery": "3.7.1"
    },
    "devDependencies": {
        "@electron-forge/cli": "^8.0.1",
        "@electron-forge/maker-deb": "^8.0.1",
        "@electron-forge/maker-rpm": "^8.0.1",
        "@electron-forge/maker-squirrel": "^8.0.1",
        "@electron-forge/maker-zip": "^8.0.1",
        "del": "6.0.0",
        "electron": "^45.0.0",
        "gulp": "^5.0.1",
        "gulp-concat": "^2.6.1",
        "gulp-less": "^5.0.0",
        "gulp-rename": "^2.0.0",
        "gulp-sass": "5.1.0",
        "gulp-uglify-es": "3.0.0",
        "jsdoc": "^4.0.2",
        "nodemon": "^3.1.14",
        "sass": "^1.77.8"
    },
    "config": {
        "forge": {
            "packagerConfig": {
                "ignore": [
                    "src",
                    "public_html/scss",
                    "nbproject",
                    "testfiles",
                    ".gitignore",
                    "gulpfile.js"
                ],
                "asar": true,
                "prune": true
            },
            "makers": [
                {
                    "name": "@electron-forge/maker-squirrel",
                    "config": {
                        "name": "electron-start"
                    }
                },
                {
                    "name": "@electron-forge/maker-zip",
                    "platforms": [
                        "darwin"
                    ]
                },
                {
                    "name": "@electron-forge/maker-deb",
                    "config": {}
                },
                {
                    "name": "@electron-forge/maker-rpm",
                    "config": {}
                }
            ]
        }
    }
}
